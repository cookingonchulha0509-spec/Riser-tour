<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.EsportsApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/red_action</item>
        <item name="colorSecondary">@color/emerald_green</item>
        <item name="android:windowBackground">@color/matte_black</item>
        <item name="android:statusBarColor">@color/matte_black</item>
        <item name="android:navigationBarColor">@color/matte_black</item>
        <item name="bottomNavigationStyle">@style/CustomBottomNav</item>
    </style>

    <style name="CustomBottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/matte_black_light</item>
        <item name="itemIconTint">@color/text_white</item>
        <item name="itemTextColor">@color/text_white</item>
        <item name="itemActiveIndicatorStyle">@style/CustomIndicator</item>
    </style>

    <style name="CustomIndicator">
        <item name="color">@color/red_action</item>
    </style>
</resources>
