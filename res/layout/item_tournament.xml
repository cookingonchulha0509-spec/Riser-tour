<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/deep_navy"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/deep_navy_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/ivBanner"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="BGMI Squad Battle #102"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_margin="12dp"
            app:layout_constraintTop_toBottomOf="@id/ivBanner"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upcoming"
            android:textColor="@color/text_white"
            app:chipBackgroundColor="@color/red_action"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="12dp"/>

        <!-- Prize Pool -->
        <TextView
            android:id="@+id/tvPrizePoolLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIZE POOL"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="@id/tvTitle"/>

        <TextView
            android:id="@+id/tvPrizePool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹10,000"
            android:textColor="@color/emerald_green"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvPrizePoolLabel"
            app:layout_constraintStart_toStartOf="@id/tvPrizePoolLabel"/>

        <!-- Entry Fee -->
        <TextView
            android:id="@+id/tvEntryFeeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTRY"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="@id/tvPrizePoolLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvEntryFee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹50"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvEntryFeeLabel"
            app:layout_constraintStart_toStartOf="@id/tvEntryFeeLabel"
            app:layout_constraintEnd_toEndOf="@id/tvEntryFeeLabel"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JOIN NOW"
            android:textColor="@color/text_white"
            app:backgroundTint="@color/red_action"
            app:cornerRadius="8dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="@id/tvPrizePoolLabel"
            app:layout_constraintBottom_toBottomOf="@id/tvEntryFee"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
